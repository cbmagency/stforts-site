# GoHighLevel inbound webhook (server-side only — never exposed to the browser)
GHL_WEBHOOK_URL=
# GoHighLevel chat widget id (from Sites > Chat Widget > Get Code: data-widget-id)
NEXT_PUBLIC_GHL_WIDGET_ID=
# Google Analytics 4
NEXT_PUBLIC_GA4_ID=G-XERR37GRYJ
# GoHighLevel form id (Sites > Forms > Integrate). When set, the site shows the GHL form
# instead of its built-in form, and submissions go straight into GHL.
NEXT_PUBLIC_GHL_FORM_ID=
# GHL booking calendar permanent link (Calendars > share icon). Shows "Book a virtual consultation" on the Pre-Planning page.
NEXT_PUBLIC_GHL_BOOKING_URL=
